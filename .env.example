# Salin file ini jadi ".env" (di root proyek, sejajar dengan package.json),
# lalu isi dua nilai di bawah dengan punyamu sendiri dari dashboard Supabase.
# Lihat KOMENTAR_SETUP.md untuk langkah lengkapnya.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Email akun yang boleh login sebagai admin (satu-satunya akun yang bisa
# menambahkan gambar ke galeri publik). Harus sama persis dengan email dari
# akun Google/Facebook/Apple yang dipakai login. Lihat LOGIN_GALERI_SETUP.md.
VITE_ADMIN_EMAIL=
